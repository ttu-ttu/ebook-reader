# Copy to .env and adjust. Used by docker-compose.yml.

# The Calibre library (the folder with metadata.db). The catalog writes cover.jpg
# files into book folders without a cover, and the import profile adds books.
LIBRARY_PATH=/path/to/Calibre
# Reader data: synced books and progress, accounts, catalog. Back this up.
DATA_PATH=./data
# Owner of the library and data folders (`id -u` / `id -g`).
PUID=1000
PGID=1000
HTTP_PORT=8080

# Signing in, offline mode and installing as an app need HTTPS: put a reverse
# proxy (Caddy, Traefik, Nginx Proxy Manager, Tailscale serve) in front of
# HTTP_PORT. If the HTTPS name differs from the plain-HTTP one, the HTTP page
# links there to sign in (rebuild after changing: docker compose build web).
PUBLIC_HTTPS_URL=
# 1 = also allow signing in (and so managing accounts and adding books) on the
# plain-HTTP address. Off by default: passwords, sessions and synced settings
# (including AI API keys) then cross the network unencrypted. Only for a trusted
# home network without HTTPS; the app shows a warning while it is in use.
ALLOW_HTTP_ACCOUNTS=0
# Address(es) of that reverse proxy, so nginx sees the real client address.
# Without it, every visitor counts as the proxy's (usually private) network.
REAL_IP_FROM=
# Signed-out readers from these networks may read the library and save to the
# shared sync folder; everyone else needs an account. Empty (the default) =
# always need an account. For a home server, e.g. LAN and Tailscale:
#   TRUSTED_NETWORKS=10.0.0.0/8 192.168.0.0/16 100.64.0.0/10 fc00::/7
# but only if no reverse proxy on another LAN machine forwards internet visitors
# without REAL_IP_FROM. Don't add 172.16.0.0/12 (Docker's own network): a reverse
# proxy on this host connects from there, making every internet visitor trusted.
TRUSTED_NETWORKS=
# 1 = anyone who can reach the server may browse and download the library
# without an account.
PUBLIC_READS=0
# Uploads are refused when the data disk has less than this many MB free.
MIN_FREE_MB=1024

# Prebuilt images instead of building here: IMAGE_PREFIX=ghcr.io/<owner>/<repository>
# and IMAGE_TAG=<version> (or latest), then docker compose pull && docker compose up -d.
IMAGE_PREFIX=ebook-reader
IMAGE_TAG=local

# Repository the admin panel's updater installs from (servers set up with
# scripts/deploy.sh; the newest commit on main).
UPDATE_REPO=blankiekun/chimimouryou

# Optional services: import (adding books to Calibre; large image) and
# difficulty (difficulty estimates), e.g. COMPOSE_PROFILES=import,difficulty
COMPOSE_PROFILES=

# Minutes between catalog checks are CATALOG_INTERVAL seconds / 60.
CATALOG_INTERVAL=600
# Processes for difficulty estimates (each needs about 1 GB of RAM).
DIFFICULTY_WORKERS=2
