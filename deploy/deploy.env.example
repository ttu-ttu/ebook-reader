# Copy to local/deploy.env for scripts/deploy.sh (local/ is gitignored).

# Where the stack runs:
#   pct:<id>          a Proxmox container, from its host (uses sudo pct exec)
#   ssh:<user@host>   any server over SSH (root, or set REMOTE_SUDO=sudo with
#                     passwordless sudo)
#   local             this machine (uses sudo unless run as root)
TARGET=ssh:root@books.example
#REMOTE_SUDO=sudo
# Extra ssh arguments, e.g. a key or port.
#SSH_OPTIONS="-i ~/.ssh/books_ed25519 -p 2222"

# Shown after a deploy (optional).
SITE_URL=http://books.example:8080/
