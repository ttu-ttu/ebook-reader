 #include "coding2utf16.h"
 #include "Utils.h"
 
+#if defined(WEB)
+#include <emscripten.h>
+#endif
+
+// chimimouryou: where each character of the page was drawn (byte offset in the page,
+// x, y and font size in screen pixels), so the web page can lay hoverable text over it.
+static int char_boxes[4 * 4096];
+static int char_box_count = 0;
+
+static void addCharBox(int offset, int x, int y, int size)
+{
+    // Offsets only grow within a page: a smaller one starts the next page.
+    if (char_box_count && offset <= char_boxes[4 * (char_box_count - 1)]) char_box_count = 0;
+    if (char_box_count >= 4096) return;
+    int *box = char_boxes + 4 * char_box_count++;
+    box[0] = offset;
+    box[1] = x;
+    box[2] = y;
+    box[3] = size;
+}
+
+// chimimouryou: hand the page shown so far (raw script bytes) and its character boxes to
+// the web page, for hover lookups, its text panel and reading statistics. skipped is set
+// while the reader skips text.
+static void textHook(const char *text, int len, int skipped)
+{
+    if (char_box_count && char_boxes[4 * (char_box_count - 1)] >= len) char_box_count = 0;
+#if defined(WEB)
+    EM_ASM({
+        if (self.onsyuriText)
+            self.onsyuriText(HEAPU8.slice($0, $0 + $1), $2, HEAP32.slice($3 >> 2, ($3 >> 2) + $4 * 4));
+    }, text, len, skipped, char_boxes, char_box_count);
+#endif
+}
